; 《超级矿工》Godot 4 项目配置。手写维护，不需要打开编辑器。
config_version=5

[application]

config/name="超级矿工"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.035, 0.06, 1)
boot_splash/show_image=false

[autoload]

Net="*res://scripts/net.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.02, 0.022, 0.04, 1)
